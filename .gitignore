.DS_Store

# Deft framework: ignore local-only caches and scratch directories
# Hybrid deposit (#1942): reconstituted by `directive init` like node_modules.
# The vendored→hybrid un-commit for existing tracked deposits is #1941.
.deft-cache/
.deft/cache/
.deft/.cli/
.deft/ritual-state.json
.deft/last-session.json
.deft/routing.local.json
vbrief/.triage-cache/candidates.jsonl
vbrief/.triage-cache/summary-history.jsonl
vbrief/.triage-cache/scope-lifecycle.jsonl
vbrief/.triage-cache/decompositions/
vbrief/.triage-cache/doctor-state.json
xbrief/.triage-cache/candidates.jsonl
xbrief/.triage-cache/summary-history.jsonl
xbrief/.triage-cache/scope-lifecycle.jsonl
xbrief/.triage-cache/decompositions/
xbrief/.triage-cache/doctor-state.json
vbrief/*.lock
.deft/core.bak-*/
.deft/*.bak-*
.deft/xbrief-migrate-backup-*/
*.premigrate.*
vbrief/.eval/results/
xbrief/.eval/results/
.deft/core/

# Deft / Directive: only the surfaces `directive init` regenerates stay out.
# Changed 2026-09-05 — xbrief/, .deft/ (minus the vendored deposit), AGENTS.md,
# Taskfile.yml, .githooks/, .gitattributes and .prettierignore are now TRACKED.
# Directive's integrity gates (verify:forward-coverage, verify:scope-provenance,
# verify:orphan-active) are all defined against the MERGE BASE. An untracked
# xbrief/ has no merge base, so ignoring it did not merely hide work state —
# it disabled the gates. The vendored deposit .deft/core/ stays ignored above:
# that one IS canonical (hybrid deposit #1942, reconstituted like node_modules).

# Generated redirect stubs — each is a 6-line pointer into .deft/core/SKILL.md,
# which is itself untracked, so tracking these would version a dangling ref.
.agents/
.github/skills/

# Agent/assistant host configs installed by Directive — per-machine, per-host.
.claude/
.codex/
.cursor/
.grok/
.deft-run-summary.json
.deft-directive-disable

# Third-party tool config, not Directive's.
greptile.json

# Directive-installed CI — still unrequested. Enabling Actions on a public repo
# is a separate decision; nothing in the local gate set depends on these.
.github/workflows/deft-core-guard.yml
.github/codeql/codeql-config.yml

# Plugin architecture — local wiring is NEVER committed (epic D2/D7).
# The public repository contains the extension point (PluginBootstrap.swift) and
# nothing that uses it: no module name, no package reference, no roster.
ViLM/LocalPlugins.swift
# Local plugin sources, symlinked in from their own private repo.
# ViLM/ is a synchronized folder, so this compiles automatically when present
# and simply does not exist in a clean public clone.
ViLM/LocalPlugins/
*.local.xcconfig
LocalPlugins.xcconfig

# --- managed by notion-sync ---
# Generated from the unified Notion Constitution / Standards and NEVER committed.
# ⚠️ This repo is PUBLIC and these files carry 3Ci operational detail — PAC deploy
# discipline, the gh identity procedure, the agy audit contract. Committing them is a
# Constitution Art. V breach in the direction people forget: the usual worry is personal
# code reaching work, and this is the reverse.
# The rule names this ONE subtree on purpose. A bare `docs/` rule was applied across the
# 3Ci repos on 2026-08-14 and staged 11 hand-written files for deletion — provenance is a
# property of the file, not of its path. `docs/specs/` and `docs/app/` stay tracked here.
docs/standards/
# --- end managed by notion-sync ---

